# 4 ".\\./Player.h" 2

struct Position {
        int x;
        int y;
};

struct Tail;

class Player {
private:
        Tail* tailOne;
        int _length = 2;

        Position pos {
                .x = 0,
                .y = 0
        };

public:
        Player(int x, int y);
        Player();

        void DrawPlayer(std::vector<std::vector<int>>& map, int x, int y);
};



struct Tail {
        Position position;
        Tail* next;

        Tail(Position pos) {
                position = pos;
        }

        void Draw(std::vector<std::vector<int>>& map, int length) {

                int rows = map.size();
                int cols = map[0].size();


                int previousX = position.x;
                int previousY = position.y;

                if (next != nullptr) {
                        next->position = {
                                .x = previousX,
                                .y = previousY
                        };
                }





                if (previousY >= rows - 2) {
                        position.y = previousY % rows;
                } else if (previousX >= cols - (3 + length)) {
                        position.x = previousX % cols;
                }


                if (map[previousY].at(previousX) != 1) {

                map[previousY].at(previousX) = 0;
                }


                if (map[previousY].at(previousX) == 0) {

                map[previousY].at(previousX) = 2;
                }

                if (next != nullptr) {
                        next->Draw(map, length);
                }
        }
};
# 2 "player.cpp" 2

Player::Player() {
  pos.x = 0;
  pos.y = 0;

  Tail* newTail = new Tail(Position{.x = 0, .y = 0});
  tailOne = newTail;
}

Player::Player(int x, int y) {
  pos.x = x;
  pos.y = y;

  Tail* newTail = new Tail(Position{.x = 0, .y = 0});
  tailOne = newTail;
}






void Player::DrawPlayer(std::vector<std::vector<int>>& map, int x, int y) {

  int rows = map.size();
  int cols = map[0].size();


  int previousX = pos.x;
  int previousY = pos.y;

  Position previousTailOne;

  if (tailOne != nullptr) {
    previousTailOne = tailOne->position;

    tailOne->position = {
      .x = previousX,
      .y = previousY
    };
  }


  int posX = x;
  int posY = y;





  if (posY >= rows - 2) {
    posY = posY % rows;
  } else if (posX >= cols - 2) {
    posX = posX % cols;
  }


  if (map[previousY].at(previousX) != 1) {

    map[previousY].at(previousX) = 0;
  }

  if (map[previousTailOne.y].at(previousTailOne.x) != 1) {
    map[previousTailOne.y].at(previousTailOne.x) = 0;
  }


  pos.x = posX;
  pos.y = posY;


  if (map[pos.y].at(pos.x) == 0) {

    map[pos.y].at(pos.x) = 2;
  }

  if (tailOne != nullptr) {
    tailOne->Draw(map, _length);
  }
}
